    <mxCell id="topMemo" value="여기서 답이 나오면 뒤쪽 검문소는 요청이 왔다는 사실조차 모른다" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B6B6B;" vertex="1" parent="1">
