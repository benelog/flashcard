    <mxCell id="sw" value="서비스 워커&lt;br&gt;Cache Storage&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;우리 코드가 전부 정한다&lt;br&gt;&lt;span style=&quot;font-family:Courier New&quot;&gt;caches.delete&lt;/span&gt;로&lt;br&gt;골라 지운다&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE2F3;strokeColor=#4A7BA6;fontColor=#1F4E79;fontSize=14;fontStyle=1;" vertex="1" parent="1">
