    <mxCell id="s5" value="⑤ 옛 칼럼 제거&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;축소(contract)&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#E4D7F5;strokeColor=#8E6BBF;fontColor=#4A2C7A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
