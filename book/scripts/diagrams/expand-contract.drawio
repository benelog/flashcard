      <mxGeometry x="147.5" y="204" width="110" height="56" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="③ 데이터 복사&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;옛 칼럼 → 새 칼럼&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#E4D7F5;strokeColor=#8E6BBF;fontColor=#4A2C7A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
