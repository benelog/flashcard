    <mxCell id="s4" value="④ 읽기 전환&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;새 칼럼만 읽는다&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE2F3;strokeColor=#4A7BA6;fontColor=#1F4E79;fontSize=14;fontStyle=1;" vertex="1" parent="1">
