    <mxCell id="b1" value="건드리지 않는다&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;network only · 평소대로 네트워크로&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#EDEDED;strokeColor=#8C8C8C;fontColor=#333333;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="290" y="117" width="220" height="56" as="geometry"/>
    </mxCell>
    <mxCell id="m1" value="예: 채점 POST · &lt;span style=&quot;font-family:Courier New&quot;&gt;/api/&lt;/span&gt; 응답 · 다른 사이트" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B6B6B;" vertex="1" parent="1">
      <mxGeometry x="290" y="175" width="220" height="18" as="geometry"/>
    </mxCell>

    <mxCell id="d2" value="&lt;span style=&quot;font-family:Courier New&quot;&gt;mode === &amp;quot;navigate&amp;quot;&lt;/span&gt;?&lt;br&gt;(페이지 HTML)" style="rhombus;html=1;fillColor=#FFF2CC;strokeColor=#B7950B;fontColor=#5C4A00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="10" y="230" width="240" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="b2" value="network-first&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;성공 → 응답 + PAGES에 저장&lt;br&gt;실패 → PAGES 사본 → offline.html&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE2F3;strokeColor=#4A7BA6;fontColor=#1F4E79;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="290" y="250" width="220" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="m2" value="예: 홈 화면 · 덱 목록 페이지" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B6B6B;" vertex="1" parent="1">
      <mxGeometry x="290" y="322" width="220" height="18" as="geometry"/>
    </mxCell>

    <mxCell id="b3" value="stale-while-revalidate&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;STATIC 사본 즉시 → 뒤에서 갱신&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE2F3;strokeColor=#4A7BA6;fontColor=#1F4E79;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="10" y="380" width="240" height="56" as="geometry"/>
