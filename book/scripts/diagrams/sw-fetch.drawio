<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="fetch" value="fetch 이벤트&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;브라우저가 보내는 요청 하나&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#FBE4CC;strokeColor=#D79B63;fontColor=#7F5124;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="8" width="180" height="56" as="geometry"/>
    </mxCell>

    <mxCell id="d1" value="GET이 아니거나&lt;br&gt;&lt;span style=&quot;font-family:Courier New&quot;&gt;/api/&lt;/span&gt; 이거나&lt;br&gt;다른 오리진?" style="rhombus;html=1;fillColor=#FFF2CC;strokeColor=#B7950B;fontColor=#5C4A00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="10" y="90" width="240" height="110" as="geometry"/>
