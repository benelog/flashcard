    <mxCell id="body" value="#study-body&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;font-family:Noto Sans KR,sans-serif&quot;&gt;카드 한 장과 채점 버튼&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#FFFFFF;strokeColor=#D79B63;fontColor=#7F5124;fontSize=13;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
