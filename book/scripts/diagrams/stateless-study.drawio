    <mxCell id="sb" value="studyBody&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;font-family:Noto Sans KR,sans-serif&quot;&gt;다음 조각 렌더링&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#FFFFFF;strokeColor=#4A7BA6;fontColor=#1F4E79;fontSize=13;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
