    <mxCell id="rec" value="RecordReview&lt;br&gt;&lt;span style=&quot;font-family:Noto Sans KR,sans-serif&quot;&gt;(서버에 남는 것은 이것뿐)&lt;/span&gt;" style="strokeColor=#4D4D4D;strokeWidth=1.5;endArrow=classic;endFill=1;html=1;fontSize=12;fontColor=#6B6B6B;fontFamily=Courier New;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="server" target="db">
