    <mxCell id="server" value="서버" style="rounded=1;arcSize=6;html=1;fillColor=#CFE2F3;strokeColor=#4A7BA6;fontColor=#1F4E79;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
      <mxGeometry x="430" y="60" width="230" height="270" as="geometry"/>
