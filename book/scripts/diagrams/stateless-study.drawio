    <mxCell id="grade" value="채점 · Missed에 쌓기" style="rounded=1;arcSize=12;html=1;fillColor=#FFFFFF;strokeColor=#4A7BA6;fontColor=#1F4E79;fontSize=13;fontStyle=1;" vertex="1" parent="1">
