{
  "skillOverrides": {
    "drawio": "on"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/go-check.sh\"",
            "timeout": 60,
            "statusMessage": "gofmt + go vet 검사 중..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "korean-tech-writing@korean-tech-writing": true
  },
  "extraKnownMarketplaces": {
    "korean-tech-writing": {
      "source": {
        "source": "github",
        "repo": "benelog/korean-tech-writing"
      }
    }
  }
}
