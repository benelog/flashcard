{
  "skillOverrides": {
    "drawio": "on"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/go-check.sh\"",
            "timeout": 60,
            "statusMessage": "gofmt + go vet 검사 중..."
          }
        ]
      }
    ]
  }
}
