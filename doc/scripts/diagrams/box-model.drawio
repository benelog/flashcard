<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="margin" value="" style="rounded=0;html=1;fillColor=#FBE4CC;strokeColor=#D79B63;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="40" width="640" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="border" value="" style="rounded=0;html=1;fillColor=#54677A;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="100" y="90" width="520" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="padding" value="" style="rounded=0;html=1;fillColor=#D9EAD3;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="134" y="124" width="452" height="132" as="geometry"/>
    </mxCell>
    <mxCell id="content" value="" style="rounded=0;html=1;fillColor=#CFE2F3;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="200" y="160" width="320" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="lab-margin" value="바깥 여백 margin" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#7F5124;" vertex="1" parent="1">
      <mxGeometry x="52" y="52" width="220" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="code-margin" value="margin-bottom: 0.5rem" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontColor=#8C6239;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="428" y="52" width="240" height="22" as="geometry"/>
    </mxCell>

    <mxCell id="lab-border" value="테두리 border" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="112" y="96" width="200" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="code-border" value="border: 1px solid" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontColor=#E4EAF0;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="388" y="96" width="220" height="22" as="geometry"/>
    </mxCell>

    <mxCell id="lab-padding" value="안쪽 여백 padding" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#3F6B2B;" vertex="1" parent="1">
      <mxGeometry x="146" y="132" width="200" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="code-padding" value="padding: 0.75rem 1rem" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontColor=#3F6B2B;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="334" y="132" width="240" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="lab-content" value="내용 content" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
      <mxGeometry x="200" y="172" width="320" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="lab-content-ex" value="apple 사과" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="200" y="192" width="320" height="18" as="geometry"/>
    </mxCell>

    <mxCell id="guide-c-left" style="endArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#9AA0A6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="200" y="222" as="sourcePoint"/>
        <mxPoint x="200" y="388" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="guide-c-right" style="endArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#9AA0A6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="520" y="222" as="sourcePoint"/>
        <mxPoint x="520" y="388" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="guide-b-left" style="endArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#9AA0A6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="100" y="292" as="sourcePoint"/>
        <mxPoint x="100" y="438" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="guide-b-right" style="endArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#9AA0A6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="620" y="292" as="sourcePoint"/>
        <mxPoint x="620" y="438" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="arrow-content" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#1F4E79;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="200" y="388" as="sourcePoint"/>
        <mxPoint x="520" y="388" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="arrow-border" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#4D4D4D;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="100" y="438" as="sourcePoint"/>
        <mxPoint x="620" y="438" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <mxCell id="lab-arrow-content" value="기본값일 때 width가 재는 폭" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontColor=#1F4E79;" vertex="1" parent="1">
      <mxGeometry x="200" y="364" width="320" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="lab-arrow-border" value="box-sizing: border-box일 때 width가 재는 폭" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontColor=#4D4D4D;" vertex="1" parent="1">
      <mxGeometry x="100" y="414" width="520" height="20" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
